# Skopiuj do .env (w tym samym katalogu) i uzupelnij. Plik .env nie trafia do gita.
# Czytaja go: docker compose (wszystkie trzy uslugi) i backend uruchamiany lokalnie.
# Wartosci bez cudzyslowow.

# Uzytkownik i haslo lokalnej bazy PostgreSQL z docker-compose.yml.
# Haslo wymysl dowolne - baza powstaje z nim przy pierwszym `docker compose up`.
DB_USERNAME=dziennik
DB_PASSWORD=

# Dane testowe z backend/src/main/resources/data.sql (2 uzytkownikow z lekami).
# Tylko lokalnie - na produkcji zostaw puste (domyslnie never).
DB_SEED=always

# Client ID z Google Cloud Console (ten sam co VITE_GOOGLE_CLIENT_ID we frontend/.env).
# Client secret NIE jest potrzebny.
# Client ID z Google Cloud Console. Dostaja go backend i build frontendu
# (jako VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Ktora wersje obrazow z ghcr.io uruchomic, np. IMAGE_TAG=latest przed `docker compose pull`.
# Pominiete = tag "dev", czyli obrazy zbudowane lokalnie przez `--build`.
# IMAGE_TAG=latest
