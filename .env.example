# Skopiuj do .env (w tym samym katalogu) i uzupelnij. Plik .env nie trafia do gita.
# Czytaja go: docker compose (wszystkie trzy uslugi) i backend uruchamiany lokalnie.
# Wartosci bez cudzyslowow.

# Uzytkownik i haslo lokalnej bazy PostgreSQL z docker-compose.yml.
# Haslo wymysl dowolne - baza powstaje z nim przy pierwszym `docker compose up`.
DB_USERNAME=dziennik
DB_PASSWORD=

# Tryb deweloperski backendu. "local" wlacza dane testowe z backend/src/main/resources/data.sql
# (tester jan@example.com z 6 lekami) i logowanie na niego bez Google: POST /api/auth/dev-login.
# Na produkcji MUSI zostac puste.
# SPRING_PROFILES_ACTIVE=local
SPRING_PROFILES_ACTIVE=

# Tylko z SPRING_PROFILES_ACTIVE=local: Twoj adres Google. Przy pierwszym logowaniu przez Google
# to konto przejmuje testera z data.sql (6 lekow) i od tej pory loguje sie prosto na niego.
# DEV_TESTER_EMAIL=ty@gmail.com
DEV_TESTER_EMAIL=

# Przycisk "Zaloguj jako tester" we frontendzie (build w Dockerze). Dziala tylko razem
# z SPRING_PROFILES_ACTIVE=local. Na produkcji MUSI zostac puste - bez tego kod przycisku nie trafia do bundla.
# VITE_DEV_LOGIN=true
VITE_DEV_LOGIN=

# Client ID z Google Cloud Console (ten sam co VITE_GOOGLE_CLIENT_ID we frontend/.env).
# Client secret NIE jest potrzebny.
# Client ID z Google Cloud Console. Dostaja go backend i build frontendu
# (jako VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Ktora wersje obrazow z ghcr.io uruchomic, np. IMAGE_TAG=latest przed `docker compose pull`.
# Pominiete = tag "dev", czyli obrazy zbudowane lokalnie przez `--build`.
# IMAGE_TAG=latest

# Klucz API kolejkisor.pl (kolejki na SOR-ach). Wygeneruj w https://kolejkisor.pl/account/api-keys.
# Sekret widac tylko raz, przy generowaniu. Zostaje w backendzie - frontend go nie dostaje.
# Puste = strona SOR pokazuje tylko numer alarmowy 112.
SOR_API_KEY=
SOR_API_SECRET=
